# このファイルを secrets.toml という名前でコピーして値を入れてください（secrets.toml は Git に含めません）
# Gmail / Google Workspace の例。パスワードには「アプリ パスワード」を使います

SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = 587
SMTP_SECURITY = "starttls"          # starttls / ssl / none
SMTP_USERNAME = "info@example.com"
SMTP_PASSWORD = "アプリパスワード"
SMTP_FROM = "info@example.com"
