# 必要な環境変数の一覧。値は Doppler（project: organization-diagnosis）で管理する。
# ローカル: `npm run dev:doppler`（doppler run 経由で注入）
# 本番:     Doppler の Vercel 連携で Vercel の環境変数へ自動同期
# Doppler を使わない場合のみ、このファイルを .env.local にコピーして値を入れる（.env.local は Git に含めない）

# Supabase（Project Settings → API Keys の Secret keys、sb_secret_...）。絶対にブラウザ側に出さないこと
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=

# Resend（API Keys）。MAIL_FROM は Resend で認証したドメインのアドレス
RESEND_API_KEY=
MAIL_FROM=info@example.com
